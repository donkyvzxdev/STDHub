# STDHub — example env. Copy to `.env` and fill locally. NEVER commit `.env`.
# NOTE: keys stay UNPREFIXED on purpose. A `VITE_` prefix would bake the
# value into the client bundle. Secrets are read via backend/Tauri only.

# Chatbot / AI provider key (used from T02a/config phase on)
STDHUB_CHATBOT_API_KEY=

# Web search provider key (Phase 2 research feature)
STDHUB_SEARCH_API_KEY=
